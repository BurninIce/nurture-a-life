# 可选环境变量示例（按需 set / export，本文件不会被自动加载）
#
# Windows cmd:      set NAL_SELF_ID=123456
# PowerShell:       $env:NAL_SELF_ID = "123456"
# 本项目所有变量都是**可选覆盖**：不设时按 state/setup.json → 代码默认值 解析。

# ---------- 路径 ----------
# 项目根目录（默认由 scripts/paths.py 的位置推导，一般不用设）
# NAL_HOME=D:\nurture-a-life
# bot 用的 Python 解释器（默认 <ROOT>/.venv/Scripts/python.exe）
# NAL_VENV_PY=D:\nurture-a-life\.venv\Scripts\python.exe
# Ollama 与 NapCat 的位置会自动找，顺序是环境变量 → setup.json 的 ollama_home
# / napcat_home → 项目内的 tools\Ollama、tools\NapCat\Shell → PATH 与各固定盘的
# 常见目录。装到别处又没被找到时再显式指定；这里的值可以写相对路径，
# 会按项目根目录展开，整套目录搬走后不用改。
# 没装 Ollama 时可以直接装进项目：python scripts\install_ollama.py
# （安装路径里不要有 -，脚本会拒绝带连字符的目录）
# NAL_OLLAMA_HOME=tools\Ollama
# NAL_NAPCAT_HOME=tools\NapCat\Shell

# ---------- 端口 ----------
# NAL_PORT_OLLAMA 同时决定「拉起 Ollama 时让它绑哪个端口」和「客户端连哪个端口」，
# 改一处即可；机器上已经有 OLLAMA_HOST 时按它里面的端口走。
# NAL_PORT_OLLAMA=11434
# NAL_PORT_NAPCAT_UI=6099
# NAL_PORT_BRIDGE_WS=6700
# NAL_PORT_ADMIN=6780

# ---------- 账号绑定 ----------
# 留空则走 state/setup.json（scripts/setup.py 首次运行时写入），再退默认值。
# 群号留空 = 不限制：加进哪个群就服务哪个群。
NAL_SELF_ID=10000000
NAL_GROUP_ID=1000000
NAL_ADMIN_ID=10000001

# ---------- 云端模型（千问 OpenAI 兼容端点）----------
# key 也可以写进项目根 qwen.key（已 gitignore），不建议提交到仓库
# QWEN_API_KEY=
# 端点档位（当前只有 dashscope；自定义服务请改 LOCAL_API_* 那一组）
# QWEN_PROFILE=dashscope
# 覆盖端点与 key 变量名（不设则用档位内置值）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_KEY_ENV=QWEN_API_KEY    ← 这里填的是"去读哪个环境变量的名字"，不是 key 本身

# ---------- 本地 / 自建 OpenAI 兼容服务 ----------
# 端点与模型名都由 scripts/setup.py 写进 state/setup.json；这里可临时覆盖。
# LOCAL_API_BASE_URL=http://127.0.0.1:8000/v1
# NAL_MODEL=qwen-vl
# LOCAL_API_KEY=
# LOCAL_API_CONCURRENCY=2
#
# 注意：**用哪个模型不是环境变量**。对话/判官模型在管理面板「配置」页的两张模型卡里
# 选（提供商 → 模型清单 → 应用模型，也可以直接填模型 ID），思考挡位在同一张卡上；
# 也可以直接改 state/runtime_config.json 的 gen_model / judge_model，
# 值形如 local|qwen3-8b:latest、localapi|qwen-vl、qwen|dashscope|qwen-plus。
# 代码里的 rp_config.LOCAL_API_MODEL 只是默认值常量，环境变量只用来覆盖端点与默认模型名。

# ---------- 记忆 / 硬件 / 脱敏 ----------
# 手动指定显存档位（不设则按 nvidia-smi 自动检测；档位见 scripts/hw_profile.py）
# NAL_VRAM_GB=8
# 覆盖 embedding 模型（默认随显存档位选 bge-small-zh-v1.5 或 bge-m3）
# NAL_EMBED=bge-small-zh-v1.5
# 关掉自动硬件检测（off）
# NAL_HW=off
# 出站画像脱敏：off（默认）| api（仅云端 API）| external（所有外部端点）
# NAL_API_REDACT=off

# ---------- 今日日常 ----------
# 注入给模型的场景地名（原作虚构城市，默认「示例市」）
# NAL_SCENE_CITY=示例市

# ---------- 管理面板 ----------
# 不设则每次启动生成随机 token 并落盘 state/admin_token，启动日志里打印
# NAL_ADMIN_TOKEN=

# ---------- CG ----------
# 出图身份层用的角色卡（角色 id 或卡文件路径）；不设用默认卡
# NAL_CARD=kurumi
# NAL_COMFY_URL=http://127.0.0.1:8188
# NAL_COMFY_WORKFLOW=assets\cg\workflows\sd15_t2i.json
# NAL_CG_SIZE=768x512
# NAL_CG_STEPS=20
# NAL_CG_CFG=7.0
# NAL_CG_NEGATIVE=lowres, bad anatomy, extra fingers, watermark, text

# ---------- 媒体支线（可选）----------
# 语音与 CG 走 media_port：桥接只调用，支线自己连后端。
# NAL_MEDIA=null 时整体关闭（离线跑桥接、只回文字）。

# ---------- 语音（可选，需要另起 GPT-SoVITS api_v2.py）----------
# 官方 API 默认监听 9880；参考音频是你自己录的 3-10 秒干净人声。
# NAL_TTS_URL=http://127.0.0.1:9880
# 参考音频（日常 / 战斗两套风格各一份），以及它对应的文本
# NAL_TTS_REF_AUDIO=D:\voices\ref_daily.wav
# NAL_TTS_REF_DAILY=D:\voices\ref_daily.wav
# NAL_TTS_REF_BATTLE=D:\voices\ref_battle.wav
# NAL_TTS_PROMPT_TEXT=参考音频里说的那句话
# NAL_TTS_PROMPT_DAILY=日常参考音频里说的那句话
# NAL_TTS_PROMPT_BATTLE=战斗参考音频里说的那句话
# NAL_TTS_TEXT_LANG=zh
# NAL_TTS_PROMPT_LANG=zh
# NAL_TTS_SPEED=1.0
# NAL_TTS_OUT=state\tts_cache
